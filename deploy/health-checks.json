{
  "terms-service-container": {
    "command": [
      "CMD",
      "node",
      "-e",
      "fetch('http://127.0.0.1:'+(process.env.PORT||3000)+(process.env.BASE_PATH||'/v5')+'/terms/health').then(r=>process.exit(r.ok?0:1)).catch(()=>process.exit(1))"
    ],
    "interval": 30,
    "timeout": 10,
    "retries": 3,
    "startPeriod": 30
  }
}
